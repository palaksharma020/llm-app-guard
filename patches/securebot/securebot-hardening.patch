@@ -0,0 +1,132 @@
+"""SecureBot's action policy (FIX V4, OWASP LLM06): who may do what to which order.
+
+SYNTHETIC DEMO DATA: two customers and three orders, invented for this case study. Business facts (prices,
+return windows, ownership) live here as data, never in the model's prompt or memory.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+from datetime import date, timedelta
+from decimal import Decimal, InvalidOperation
+from pathlib import Path
+
+from agentic_core import ActionPolicy, ActionProposal, ActionRule, Principal
+
+TODAY = date.today()
+RETURN_WINDOW_DAYS = {"NP-001": 30, "NPX-10": 15, "NBA-5": 30}
+PRODUCT_NAMES = {"NP-001": "NovaPad Pro", "NPX-10": "NovaPhone X", "NBA-5": "NovaBuds Air"}
+LOYALTY_DISCOUNT_CAP = 10  # percent
+
+CUSTOMERS = {  # SYNTHETIC
+    "alice@example.com": {"name": "Alice", "loyalty_member": True},
+    "bob@example.com": {"name": "Bob", "loyalty_member": False},
+}
+ORDERS = {  # SYNTHETIC
+    "A1001": {"owner": "alice@example.com", "sku": "NP-001", "price": Decimal("299.00"),
+              "delivered": TODAY - timedelta(days=10)},
+    "A1002": {"owner": "alice@example.com", "sku": "NPX-10", "price": Decimal("899.00"),
+              "delivered": TODAY - timedelta(days=40)},
+    "B2001": {"owner": "bob@example.com", "sku": "NPX-10", "price": Decimal("899.00"),
+              "delivered": TODAY - timedelta(days=5)},
+}
+REFUNDED: set[str] = set()
+DISCOUNTS: dict[str, int] = {}
+
+DECISION_LOG = Path(os.environ.get("DECISION_LOG", "logs/decisions.jsonl"))
+
+
+def _amount(text: str) -> Decimal | None:
+    try:
+        value = Decimal(text.replace("$", "").replace(",", "").strip())
+    except InvalidOperation:
+        return None
+    return value if value.is_finite() and value > 0 else None
+
+
+# Validators: return a rule id to deny, or None. Each checks one thing so the log says exactly why.
+def owns_order(args, principal: Principal):
+    order = ORDERS.get(args["order_id"].upper())
+    if order is None:
+        return "unknown_order"
+    return None if order["owner"] == principal.id else "not_owner"
+
+
+def amount_within_price(args, principal: Principal):
+    amount = _amount(args["amount"])
+    if amount is None:
+        return "bad_amount"
+    order = ORDERS.get(args["order_id"].upper())
+    return "amount_exceeds_price" if order and amount > order["price"] else None
+
+
+def inside_return_window(args, principal: Principal):
+    order = ORDERS.get(args["order_id"].upper())
+    if order is None:
+        return None  # owns_order already denies it
+    age = (TODAY - order["delivered"]).days
+    return "outside_return_window" if age > RETURN_WINDOW_DAYS[order["sku"]] else None
+
+
+def not_already_refunded(args, principal: Principal):
+    return "already_refunded" if args["order_id"].upper() in REFUNDED else None
+
+
+def own_account(args, principal: Principal):
+    return None if args["customer_email"].strip().lower() == principal.id else "not_owner"
+
+
+def loyalty_member(args, principal: Principal):
+    return None if principal.attributes.get("loyalty_member") else "not_loyalty_member"
+
+
+def discount_within_cap(args, principal: Principal):
+    try:
+        pct = int(args["percent"].replace("%", "").strip())
+    except ValueError:
+        return "bad_percent"
+    if pct <= 0:
+        return "bad_percent"
+    return "discount_over_cap" if pct > LOYALTY_DISCOUNT_CAP else None
+
+
+POLICY = ActionPolicy({
+    "REFUND": ActionRule(("order_id", "amount"),
+                         (owns_order, amount_within_price, inside_return_window, not_already_refunded)),
+    "DISCOUNT": ActionRule(("customer_email", "percent"),
+                           (own_account, loyalty_member, discount_within_cap)),
+})
+
+
+def principal_for(email: str) -> Principal:
+    return Principal(email, CUSTOMERS.get(email, {}))
+
+
+def customer_context(principal: Principal) -> str:
+    """What the model may know about the signed-in customer (their own data only)."""
+    lines = [f"SIGNED-IN CUSTOMER: {principal.id} (loyalty member: "
+             f"{'yes' if principal.attributes.get('loyalty_member') else 'no'})", "Their orders:"]
+    for oid, o in ORDERS.items():
+        if o["owner"] == principal.id:
+            age = (TODAY - o["delivered"]).days
+            lines.append(f"- {oid}: {PRODUCT_NAMES[o['sku']]} ({o['sku']}), ${o['price']}, "
+                         f"delivered {age} days ago")
+    return "\n".join(lines)
+
+
+def execute(proposal: ActionProposal) -> dict:
+    """Apply an action that has been authorized AND confirmed. In-memory demo state."""
+    if proposal.action == "REFUND":
+        REFUNDED.add(proposal.params[0].upper())
+    elif proposal.action == "DISCOUNT":
+        DISCOUNTS[proposal.params[0].strip().lower()] = int(proposal.params[1].replace("%", ""))
+    return {"action": proposal.action, "params": list(proposal.params), "status": "executed"}
+
+
+def log_decision(**fields) -> None:
+    """Append one decision to the JSONL decision log (who, what, outcome, why, which grant)."""
+    DECISION_LOG.parent.mkdir(parents=True, exist_ok=True)
+    with DECISION_LOG.open("a") as f:
+        f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **fields}) + "\n")
