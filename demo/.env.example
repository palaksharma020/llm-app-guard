# Copy to demo/.env. Never commit .env.
# Model served by your local Ollama. On an 8 GB machine, llama3.1:8b-instruct-q3_K_M fits next to Docker.
MODEL=llama3.1:8b
# The demo secret the vulnerable mode leaks and the guarded mode protects.
PROMO_CODE=TRAILHEAD25
# 64 hex chars (openssl rand -hex 32) to sign confirmation grants. Empty = random per process.
GRANT_HMAC_KEY=
